# =============================================================================
# Mini Library Management System - Environment Variables
# =============================================================================

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_NAME=library_db
DB_USER=library_user
DB_PASSWORD=library_password

MYSQL_ROOT_PASSWORD=root_secure_password
MYSQL_DATABASE=library_db
MYSQL_USER=library_user
MYSQL_PASSWORD=library_password

# JWT Configuration
JWT_SECRET=dev-secret-key-change-in-production-to-strong-random-string
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Email Configuration (MailHog for development)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Google OAuth Configuration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM Provider Configuration (MOCK or REAL)
LLM_PROVIDER=MOCK
OPENAI_API_KEY=

# Spring Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Logging Level
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_LIBRARY=DEBUG
